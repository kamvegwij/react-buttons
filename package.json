  },
  "keywords": [
    "ui",
    "buttons",
    "react"
  ],
  "author": "kamvedev",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/kamvegwij/react-buttons/issues"
  },
  "homepage": "https://github.com/kamvegwij/react-buttons#readme",
  "devDependencies": {
    "@types/react": "^16.8.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  }
